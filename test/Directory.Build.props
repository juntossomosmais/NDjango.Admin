<Project>

    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <!--
            Pinned, because multi-targeting otherwise compiles one source tree under three language
            versions: C# 12 for net8.0, 13 for net9.0, 14 for net10.0. Left to the defaults, a C# 14
            construct (the `field` keyword, say) would compile on the net10.0 pass and fail the
            net8.0 one — and `dotnet format` would happily write exactly that, since the analyzers
            follow the language version. 12 is the floor, so the compiler rejects on every pass what
            the oldest target cannot take.
        -->
        <LangVersion>12</LangVersion>
    </PropertyGroup>

    <!--
        The suite runs once per target framework, against the matching Entity Framework Core and
        ASP.NET Core major. That is the whole point of it: a green net8.0 run says nothing about
        whether the loader still reads an EF Core 10 model the same way.

        TargetFramework is empty during the outer (multi-targeting) pass, which never restores
        packages — the fallbacks only keep that pass from evaluating an empty version.
    -->
    <PropertyGroup>
        <EntityFrameworkCoreVersion Condition="'$(TargetFramework)' == 'net8.0'">8.*</EntityFrameworkCoreVersion>
        <EntityFrameworkCoreVersion Condition="'$(TargetFramework)' == 'net9.0'">9.*</EntityFrameworkCoreVersion>
        <EntityFrameworkCoreVersion Condition="'$(TargetFramework)' == 'net10.0'">10.*</EntityFrameworkCoreVersion>
        <EntityFrameworkCoreVersion Condition="'$(EntityFrameworkCoreVersion)' == ''">8.*</EntityFrameworkCoreVersion>

        <AspNetCoreVersion Condition="'$(TargetFramework)' == 'net8.0'">8.*</AspNetCoreVersion>
        <AspNetCoreVersion Condition="'$(TargetFramework)' == 'net9.0'">9.*</AspNetCoreVersion>
        <AspNetCoreVersion Condition="'$(TargetFramework)' == 'net10.0'">10.*</AspNetCoreVersion>
        <AspNetCoreVersion Condition="'$(AspNetCoreVersion)' == ''">8.*</AspNetCoreVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.6.3"/>
        <PackageReference Include="xunit" Version="2.4.2"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="2.4.5">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="coverlet.collector" Version="6.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

</Project>
